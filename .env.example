# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Pub/Sub Topics
RAW_DATA_TOPIC=raw-data-topic
ANALYZED_DATA_TOPIC=analyzed-data-topic

# BigQuery
BIGQUERY_DATASET=msa_production

# Cloud Storage
GCS_BUCKET=msa-data-bucket

# API Configuration
API_KEY_HEADER=X-API-Key
CORS_ORIGINS=*

# Application
ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Processing Configuration
BATCH_SIZE=100
MAX_WORKERS=10
PROCESSING_TIMEOUT_SECONDS=300

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2
